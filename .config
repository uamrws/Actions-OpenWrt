# ===== 编译目标配置（OpenWrt 官方源码 tag v24.10.8）=====
# 目标：x86_64（Intel 4415U 软路由）
# 说明：本文件只写目标；7 个插件清单统一放在 diy-part2.sh 中，
#       流程中 make defconfig 会自动补全依赖与内核。
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
# 根分区/组合镜像大小（单位 MB）：本固件含 OpenClash/ruby/AdGuard/collectd 等大包，
# 官方默认值偏小，设为 512 足够装下并留 opkg 升级空间；你 128GB SSD 无压力。
CONFIG_TARGET_ROOTFS_PARTSIZE=512
